# ==============================================================================
# Frontend environment (Vite). Copy to .env.local and fill in.
# ==============================================================================
# From Supabase Dashboard -> Project Settings -> API (or `npx supabase status` for the local stack).
# Both values are PUBLIC by design: they ship to the browser. Row Level Security protects the data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Cloudflare Turnstile SITE key (public) for CAPTCHA on sign-up / sign-in / password reset.
# Leave empty until you turn CAPTCHA on. Deploy a build WITH this key before enabling CAPTCHA in
# Supabase (Authentication -> Attack Protection), or password sign-in stops working.
# Local testing: 1x00000000000000000000AA always passes (pair it with secret 1x0000000000000000000000000000000AA).
VITE_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------------------------
# DO NOT add secrets here. Anything prefixed VITE_ is bundled into the public JavaScript.
#
# The AI and email keys are Supabase Edge Function secrets, set on the server only:
#   npx supabase secrets set GROQ_API_KEY=...            # required for the AI assistant
#   npx supabase secrets set GROQ_MODEL=llama-3.3-70b-versatile   # optional
#   npx supabase secrets set RESEND_API_KEY=... INVITE_FROM_EMAIL="Team <invites@yourdomain.com>"   # optional invite emails
#   npx supabase secrets set SITE_URL=https://app.yourdomain.com
# For local `supabase functions serve`, put them in supabase/functions/.env (git-ignored).
# See supabase/README.md.
# ------------------------------------------------------------------------------
